<?xml version="1.0" encoding="utf-8"?>
<!-- The sync session (refresh token) stays on this device: excluded from cloud backup and
     device-to-device transfer. The name matches AuthStore.PREFS. Notes are on the server now,
     so a new phone gets them by signing in. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="naice_sync_auth.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="naice_sync_auth.xml" />
    </device-transfer>
</data-extraction-rules>
