# Copy to `local.properties` and fill in the values.
# `local.properties` is gitignored.

# Required: path to your Android SDK
sdk.dir=/Users/you/Library/Android/sdk

# Optional: recipe-scan backend (see README). If omitted, the app builds and
# runs fine — the "scan recipe" action just shows a "not configured" message.
RECIPE_SCAN_URL=
RECIPE_SCAN_SECRET=

# Optional: Supabase sync (the same project the PWA uses). Not secrets — row-level
# security is the boundary — but kept out of the public repo. If omitted, the app
# stays local-only and "Sync & account" says sync isn't configured.
SUPABASE_URL=
SUPABASE_ANON_KEY=
